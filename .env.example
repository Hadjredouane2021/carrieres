# MySQL 8 — en local, le service Docker expose le port 3306.
DATABASE_URL="mysql://forum:forum_password@localhost:3306/forum_assurance"
MYSQL_PASSWORD="forum_password"
MYSQL_ROOT_PASSWORD="root_password"

# Auth.js — générez une valeur longue et aléatoire.
AUTH_SECRET="remplacez-par-une-chaine-aleatoire-de-32-octets"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comptes créés par le seed. À changer avant toute mise en production.
ADMIN_EMAIL="admin@forum-assurance.ma"
ADMIN_PASSWORD="changez-moi-admin"
ADMIN_NAME="Administrateur FMA"
STAFF_EMAIL="accueil@forum-assurance.ma"
STAFF_PASSWORD="changez-moi-accueil"
STAFF_NAME="Accueil Forum"

# SMTP optionnel. Sans hôte, les inscriptions restent confirmées à l'écran.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Forum des Métiers de l'Assurance <noreply@forum-assurance.ma>"
